{
	"schemaVersion": 1,
	"id": "steward",
	"version": "${version}",
	"name": "Steward",
	"description": "A GUI-first staff and moderation suite for Fabric servers.",
	"authors": [
		"SwornHero"
	],
	"contact": {
		"homepage": "https://www.swornhero.com",
		"sources": "https://github.com/golso4243/Steward",
		"issues": "https://github.com/golso4243/Steward/issues"
	},
	"license": "MPL 2.0",
	"icon": "assets/steward/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
          "com.swornhero.steward.Steward"
		],
		"client": [
			"com.swornhero.steward.StewardClient"
		],
		"fabric-datagen": [
			"com.swornhero.steward.StewardDataGenerator"
		],
		"modmenu": [
			"com.swornhero.steward.compat.modmenu.StewardModMenuIntegration"
		]
	},
	"mixins": [
		"steward.mixins.json",
		{
			"config": "steward.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"luckperms": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"steward.website": "https://www.swornhero.com",
				"steward.documentation": "https://www.swornhero.com/docs/steward",
				"steward.discord": "https://discord.gg/YOUR_INVITE"
			}
		}
	}
}